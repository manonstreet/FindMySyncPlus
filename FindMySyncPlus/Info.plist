<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>FindMySync+</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleName</key>
	<string>FindMySync+</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>LSUIElement</key>
	<true/>
	<key>GitCommit</key>
	<string>$(GIT_COMMIT)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>FindMySync+ sends locations to your Home Assistant server or MQTT broker on your local network.</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Sparkle schedules its own checks and persists the preference; these two are
	     only the starting values, and the code must not assign them on launch. The key
	     also stops Sparkle asking permission on second launch, since About has the
	     switch. -->
	<!-- Silent installs are allowed and off. A user opts in with About's switch, or with
	     the checkbox this puts on Sparkle's own alert, which sets the same value; a press
	     of Install in Home Assistant is an opt-in for that one update. Every archive is
	     still checked against the EdDSA key before it is unpacked. -->
	<key>SUAllowsAutomaticUpdates</key>
	<true/>
	<!-- Check the archive's EdDSA signature before unpacking it, not after. -->
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUFeedURL</key>
	<string>https://manonstreet.github.io/FindMySyncPlus/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>xgwA3Y2v/7xU/1YVMYsq3JoET9tNz6MSxkVudodaw1o=</string>
</dict>
</plist>
